#!/bin/bash

# Script de acceso rápido para el ecosistema Time
# Uso: ./ti [comando]

COMMAND=$1
shift # Elimina el primer argumento para pasar el resto al comando

case $COMMAND in
  sh)
    # Intenta entrar al contenedor si está vivo, si no, lo crea con bash
    docker compose exec time-ui bash 2>/dev/null || docker compose run --rm time-ui bash
    ;;
  install)
    docker compose run --rm time-ui npm install "$@"
    ;;
  uninstall)
    docker compose run --rm time-ui npm uninstall "$@"
    ;;
  build)
    docker compose run --rm time-ui npm run build
    ;;
  dev)
    # --service-ports activa el mapeo de puertos definido en docker-compose.yml
    docker compose run --rm --service-ports time-ui npm run dev -- --host
    ;;
  preview)
    docker compose run --rm --service-ports time-ui npm run preview -- --host
    ;;
  pack)
    docker compose run --rm time-ui npm pack
    ;;
  *)
    echo "Uso: ./ti {sh|install|uninstall|build|dev|preview|pack}"
    exit 1
    ;;
esac
